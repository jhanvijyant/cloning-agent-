# Set ONE of these three - whichever you have a key for.
# If more than one is set, ANTHROPIC_API_KEY wins unless you set LLM_PROVIDER.

# Option 1: Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Option 2: OpenAI (GPT)
# OPENAI_API_KEY=sk-...

# Option 3: Google Gemini
# GEMINI_API_KEY=AIza...

# Optional: force a specific provider if you have more than one key set.
# Values: anthropic | openai | gemini
# LLM_PROVIDER=openai
